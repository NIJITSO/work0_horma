generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?   @db.Text
  image       String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("categories")
}

model Product {
  id            Int            @id @default(autoincrement())
  categoryId    Int            @map("category_id")
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name          String
  slug          String         @unique
  description   String?        @db.Text
  mainImage     String         @map("main_image")
  basePrice     Decimal        @map("base_price") @db.Decimal(10, 2)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Bilingual and helper metadata
  nameAr        String?
  nameFr        String?
  subtitleAr    String?
  subtitleFr    String?
  descriptionAr String?        @db.Text
  descriptionFr String?        @db.Text
  ingredientsAr String?        @db.Text
  ingredientsFr String?        @db.Text
  usageAr       String?        @db.Text
  usageFr       String?        @db.Text

  images        ProductImage[]
  variants      ProductVariant[]

  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  image     String
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("product_images")
}

model Scent {
  id        Int              @id @default(autoincrement())
  name      String
  nameAr    String?          @map("name_ar")
  slug      String           @unique
  image     String?
  isActive  Boolean          @default(true) @map("is_active")
  variants  ProductVariant[]

  @@map("scents")
}

model Size {
  id        Int              @id @default(autoincrement())
  name      String
  nameAr    String?          @map("name_ar")
  value     String           // e.g. "250 ml", "50 ml", "250 g"
  isActive  Boolean          @default(true) @map("is_active")
  variants  ProductVariant[]

  @@map("sizes")
}

model ProductVariant {
  id         Int         @id @default(autoincrement())
  productId  Int         @map("product_id")
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  scentId    Int?        @map("scent_id")
  scent      Scent?      @relation(fields: [scentId], references: [id], onDelete: SetNull)
  sizeId     Int?        @map("size_id")
  size       Size?       @relation(fields: [sizeId], references: [id], onDelete: SetNull)
  sku        String      @unique
  price      Decimal     @db.Decimal(10, 2)
  stock      Int         @default(0)
  image      String?
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  orderItems OrderItem[]

  @@map("product_variants")
}

model Customer {
  id        Int      @id @default(autoincrement())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String?  @unique
  phone     String
  password  String?
  address   String?  @db.Text
  city      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  orders    Order[]

  @@map("customers")
}

model Order {
  id              Int         @id @default(autoincrement())
  customerId      Int?        @map("customer_id")
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderNumber     String      @unique @map("order_number")
  status          String      @default("en_attente") // en_attente, payee, expediee, livree, annulee
  totalAmount     Decimal     @map("total_amount") @db.Decimal(10, 2)
  shippingAddress String      @map("shipping_address") @db.Text
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id               Int            @id @default(autoincrement())
  orderId          Int            @map("order_id")
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId Int            @map("product_variant_id")
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  quantity         Int            @default(1)
  unitPrice        Decimal        @map("unit_price") @db.Decimal(10, 2)
  totalPrice       Decimal        @map("total_price") @db.Decimal(10, 2)

  @@map("order_items")
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String   // Salted PBKDF2 hash
  role      String   @default("admin")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}
